<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Poenariu_ElenaTeodora_Lab7.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Image
                Source="teo_pisica.jpg"
                HeightRequest="185"
                Aspect="AspectFit" />

            <Label
                Text="Hei Teodora"
                Style="{StaticResource Headline}" />

            <Label
                Text="Prima mea aplicatie .NET MAUI"
                Style="{StaticResource SubHeadline}" />

            <Button
                x:Name="CounterBtn"
                Text="Click me"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
